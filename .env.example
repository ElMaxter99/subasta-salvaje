# =============================================================================
# Subasta Salvaje · variables de entorno
# Copia este archivo a .env.local (local) o defínelas en Vercel (Settings → Environment Variables).
# NUNCA subas valores reales al repositorio.
# =============================================================================

# --- Supabase (obligatorias para el modo real) --------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: sólo servidor. Nunca la expongas en el navegador ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage (lo crea la migración 20260101000100_security.sql)
SUPABASE_STORAGE_BUCKET=game-images

# --- Proveedor de IA de imágenes (OpenAI) -------------------------------------
# Sin esta clave los trabajos de imagen quedan en cola y la UI avisa de que la IA no está configurada.
OPENAI_API_KEY=
# Opcionales:
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
# 'high' conserva mejor los detalles de la imagen original al editar; 'off' si tu modelo no lo admite.
OPENAI_IMAGE_INPUT_FIDELITY=high
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Control de acceso del anfitrión -------------------------------------------
# Lista (separada por comas) de correos autorizados como anfitrión. RECOMENDADO en producción:
# el registro de Supabase Auth es abierto y cada anfitrión puede lanzar generaciones de IA (coste).
# ALLOWED_HOST_EMAILS=tu@correo.com,otro@correo.com

# --- Worker de trabajos de imagen ---------------------------------------------
# Secreto para llamar a /api/jobs/process (Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>").
# Genera uno largo: openssl rand -hex 32
CRON_SECRET=

# --- Desarrollo ---------------------------------------------------------------
# Sin credenciales de Supabase, `npm run dev` arranca en MODO DEMO (BD local PGlite + imágenes de muestra).
# En producción el modo demo está desactivado salvo que lo fuerces (no recomendado):
# ALLOW_DEMO_MODE=true
# Para forzar el modo demo aunque existan credenciales de Supabase:
# FORCE_DEMO_MODE=true
# Directorio de datos del modo demo (por defecto ./.demo-data):
# DEMO_DATA_DIR=
