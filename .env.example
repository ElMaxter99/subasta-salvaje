# =============================================================================
# Subasta Salvaje · variables de entorno
# Copia este archivo a .env.local (local) o defínelas en Vercel (Settings → Environment Variables).
# NUNCA subas valores reales al repositorio.
# =============================================================================

# --- Supabase (obligatorias para el modo real) --------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: sólo servidor. Nunca la expongas en el navegador ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage (lo crea la migración 20260101000100_security.sql)
SUPABASE_STORAGE_BUCKET=game-images

# --- Modo de imágenes ---------------------------------------------------------
# Cada PARTIDA elige su modo al crearla:
#   · «Pegatinas con emojis»: ilustraciones locales, SIN IA, gratis e instantáneo (siempre disponible).
#   · «Con IA»: usa el proveedor de IA de abajo (sólo aparece si está configurado).
# IMAGE_PROVIDER define el proveedor de IA REAL. Vacío (por defecto) = IA desactivada: sólo existe el modo pegatinas.
# Ninguna credencial activa la IA por sí sola (no se consume cuota por accidente). Si lo pides y faltan las
# credenciales, la IA aparece como "no disponible" (nunca se cambia sola a otro proveedor ni se activa un plan de pago).
# Valores: cloudflare | openai
IMAGE_PROVIDER=
# Cadena con fallback (opcional, sustituye a IMAGE_PROVIDER): proveedores GRATUITOS en orden de preferencia, p. ej. cloudflare,…
# Si uno falla por cuota/límite/credenciales/red, se prueba el siguiente. Hoy solo existe cloudflare como gratuito, así que
# con un solo proveedor no cambia nada. Un proveedor de pago (openai) NO puede ir en una lista de varios.
# IMAGE_PROVIDERS=

# Límites de generaciones REALES (las partidas en modo pegatinas no cuentan). Enteros positivos. Se muestran en el panel del anfitrión.
# Por partida (por defecto 10) y por día para TODO el despliegue (por defecto 50). Son límites PROPIOS de la app,
# independientes de la cuota de Cloudflare: la app se detiene antes. Se muestran en el panel del anfitrión.
IMAGE_QUOTA_PER_GAME=10
IMAGE_QUOTA_PER_DAY=50
# Interruptor de seguridad general: true = apaga toda la IA real (las partidas siguen en modo pegatinas).
# IMAGE_AI_DISABLED=true

# --- Cloudflare Workers AI (primera opción real; IMAGE_PROVIDER=cloudflare) ----
# Account ID: dash.cloudflare.com → barra lateral (Workers & Pages → «Account ID») o la URL del panel.
# API token: My Profile → API Tokens → Create Token → plantilla «Workers AI» (o permiso Account · Workers AI · Read/Edit).
# Ambos son SECRETOS de servidor: nunca con prefijo NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Modelo de generación (económico, sólo texto→imagen, NO edita). Opcionales:
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# Modelo de EDICIÓN con foto de referencia (por defecto FLUX.2 klein, sin probar contra la API real; 'off' = desactivar):
# CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# CLOUDFLARE_EDIT_WIDTH=1024
# CLOUDFLARE_EDIT_HEIGHT=768

# --- Pollinations (gratuito con clave gratuita; IMAGE_PROVIDERS=cloudflare,pollinations) ---
# Límites y términos SIN verificar; la integración está SIN probar contra el servicio real. POLLINATIONS_API_KEY es un secreto (sk_…).
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# POLLINATIONS_EDIT_MODEL=black-forest-labs/flux.2-klein-4b   # vacío = sin edición real (composición)
# POLLINATIONS_IMAGE_SIZE=1024x768

# --- OpenAI (alternativa de pago; IMAGE_PROVIDER=openai) ----------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
# 'high' conserva mejor los detalles de la imagen original al editar; 'off' si tu modelo no lo admite.
OPENAI_IMAGE_INPUT_FIDELITY=high
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Control de acceso del anfitrión -------------------------------------------
# Lista (separada por comas) de correos autorizados como anfitrión. RECOMENDADO en producción:
# el registro de Supabase Auth es abierto y cada anfitrión puede lanzar generaciones de IA (coste).
# ALLOWED_HOST_EMAILS=tu@correo.com,otro@correo.com

# --- Borrado automático de partidas ---------------------------------------------
# Horas SIN ACTIVIDAD tras las que una partida se borra sola (con sus imágenes). Por defecto 12.
# GAME_TTL_HOURS=12

# --- Worker de trabajos de imagen ---------------------------------------------
# Correo propio con Resend (opcional). Ambas son necesarias; sin ellas la app no envía correos propios.
# Verifica antes el dominio en Resend (DNS SPF/DKIM). RESEND_API_KEY es un secreto: solo en Vercel/.env.local.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Subida de fotos de plantillas desde /admin/plantillas (arrastrar y soltar) a un repositorio PÚBLICO de GitHub servido por jsDelivr.
# El token es un secreto: fino, solo para ese repositorio y con permiso «Contents: Read and write». Solo en Vercel/.env.local.
# GITHUB_ASSETS_REPO=usuario/repositorio-de-fotos
# GITHUB_ASSETS_TOKEN=
# GITHUB_ASSETS_BRANCH=main

# Servidores permitidos para las fotos de las plantillas del sistema (CDN propio), separados por comas. Vacío = cualquier https.
# ASSET_CDN_HOSTS=cdn.tudominio.com

# Estadísticas de visitas de Vercel (Web Analytics, sin cookies). Hay que activarlo también en Vercel → Analytics. Para apagarlo del todo:
# NEXT_PUBLIC_DISABLE_ANALYTICS=true

# Secreto para llamar a /api/jobs/process (Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>").
# Genera uno largo: openssl rand -hex 32
CRON_SECRET=

# --- Desarrollo ---------------------------------------------------------------
# Sin credenciales de Supabase, `npm run dev` arranca en MODO DEMO (BD local PGlite + imágenes de muestra).
# En producción el modo demo está desactivado salvo que lo fuerces (no recomendado):
# ALLOW_DEMO_MODE=true
# Para forzar el modo demo aunque existan credenciales de Supabase:
# FORCE_DEMO_MODE=true
# Directorio de datos del modo demo (por defecto ./.demo-data):
# DEMO_DATA_DIR=

# Edición por composición cuando el modelo de Cloudflare no edita (por defecto activa). false = desactivar.
# IMAGE_EDIT_COMPOSE=true
# Modelo de edición con foto de referencia (por defecto FLUX.2 klein). 'off' = sin edición real (solo composición).
# CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# --- Superadmin (panel /admin) ---------------------------------------------------
# Correo(s) del superadmin, separados por comas (la cuenta debe tener el correo CONFIRMADO). Sin esta variable /admin da 404.
# En modo demo (sin Supabase) el anfitrión local es superadmin. Estos ajustes se editan luego en caliente desde /admin → Ajustes:
# registro abierto/cerrado, borrado automático (días), interruptor de IA y topes de cuota (ganan a las variables de abajo).
# # Exigir TOTP (verificación en dos pasos de Supabase Auth) para usar /admin. Opt-in. Antes activa MFA/TOTP en Supabase
# (Authentication → Sign In / Providers → Multi-Factor). Sin probar contra Supabase real; si algo falla, quita la variable.
# SUPERADMIN_REQUIRE_MFA=true
SUPERADMIN_EMAILS=tu@correo.com
# Topes del plan de Supabase que se muestran en el panel (solo informativos; contrástalos con la página de precios):
# SUPABASE_PLAN_DB_MB=500
# SUPABASE_PLAN_STORAGE_MB=1024
# Borrado automático por inactividad (por defecto 168 h = 7 días). El superadmin lo cambia en caliente.
# GAME_TTL_HOURS=168

# URL pública de la app (Open Graph: miniaturas al compartir enlaces)
NEXT_PUBLIC_SITE_URL=

# --- Datos del titular para las páginas legales (/legal, /privacidad...) ---------------
# Opcionales. Si faltan, las páginas muestran «Titular pendiente de completar por el propietario». No se inventan datos.
# Son públicas (NEXT_PUBLIC_*) y se incrustan al compilar: tras cambiarlas hay que volver a desplegar.
# NEXT_PUBLIC_LEGAL_NAME=
# NEXT_PUBLIC_LEGAL_EMAIL=
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_NIF=
