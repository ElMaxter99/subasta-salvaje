# =============================================================================
# Subasta Salvaje · variables de entorno
# Copia este archivo a .env.local (local) o defínelas en Vercel (Settings → Environment Variables).
# NUNCA subas valores reales al repositorio.
# =============================================================================

# --- Supabase (obligatorias para el modo real) --------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: sólo servidor. Nunca la expongas en el navegador ni la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage (lo crea la migración 20260101000100_security.sql)
SUPABASE_STORAGE_BUCKET=game-images

# --- Modo de imágenes ---------------------------------------------------------
# Cada PARTIDA elige su modo al crearla:
#   · «Pegatinas con emojis»: ilustraciones locales, SIN IA, gratis e instantáneo (siempre disponible).
#   · «Con IA»: usa el proveedor de IA de abajo (sólo aparece si está configurado).
# IMAGE_PROVIDER define el proveedor de IA REAL. Vacío (por defecto) = IA desactivada: sólo existe el modo pegatinas.
# Ninguna credencial activa la IA por sí sola (no se consume cuota por accidente). Si lo pides y faltan las
# credenciales, la IA aparece como "no disponible" (nunca se cambia sola a otro proveedor ni se activa un plan de pago).
# Valores: cloudflare | openai
IMAGE_PROVIDER=

# Límites de generaciones REALES (las partidas en modo pegatinas no cuentan). Enteros positivos. Se muestran en el panel del anfitrión.
IMAGE_QUOTA_PER_GAME=30
IMAGE_QUOTA_PER_DAY=100

# --- Cloudflare Workers AI (primera opción real; IMAGE_PROVIDER=cloudflare) ----
# Account ID: dash.cloudflare.com → barra lateral (Workers & Pages → «Account ID») o la URL del panel.
# API token: My Profile → API Tokens → Create Token → plantilla «Workers AI» (o permiso Account · Workers AI · Read/Edit).
# Ambos son SECRETOS de servidor: nunca con prefijo NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Modelo de generación (económico, sólo texto→imagen, NO edita). Opcionales:
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# Modelo de EDICIÓN (opcional; sin él las compras se registran pero la edición de la casa no está disponible):
# CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# CLOUDFLARE_EDIT_WIDTH=1024
# CLOUDFLARE_EDIT_HEIGHT=768

# --- OpenAI (alternativa de pago; IMAGE_PROVIDER=openai) ----------------------
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
# 'high' conserva mejor los detalles de la imagen original al editar; 'off' si tu modelo no lo admite.
OPENAI_IMAGE_INPUT_FIDELITY=high
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Control de acceso del anfitrión -------------------------------------------
# Lista (separada por comas) de correos autorizados como anfitrión. RECOMENDADO en producción:
# el registro de Supabase Auth es abierto y cada anfitrión puede lanzar generaciones de IA (coste).
# ALLOWED_HOST_EMAILS=tu@correo.com,otro@correo.com

# --- Worker de trabajos de imagen ---------------------------------------------
# Secreto para llamar a /api/jobs/process (Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>").
# Genera uno largo: openssl rand -hex 32
CRON_SECRET=

# --- Desarrollo ---------------------------------------------------------------
# Sin credenciales de Supabase, `npm run dev` arranca en MODO DEMO (BD local PGlite + imágenes de muestra).
# En producción el modo demo está desactivado salvo que lo fuerces (no recomendado):
# ALLOW_DEMO_MODE=true
# Para forzar el modo demo aunque existan credenciales de Supabase:
# FORCE_DEMO_MODE=true
# Directorio de datos del modo demo (por defecto ./.demo-data):
# DEMO_DATA_DIR=
